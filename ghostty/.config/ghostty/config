# Font
font-family = Share Tech Mono
font-family-bold = Share Tech Mono
font-family-italic = Share Tech Mono
font-family-bold-italic = Share Tech Mono
font-size = 18

# Nerd Font icons fallback
font-family = Symbols Nerd Font Mono

# Theme (options: matrix, imperial, wayne-tech)
theme = Wayne-tech

# Window
window-padding-x = 8
window-padding-y = 8

# Cursor
cursor-style = bar
cursor-color = 5b8fbd